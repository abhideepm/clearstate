<?xml version="1.0" encoding="utf-8"?>
<!-- BioState widget layout with horizontal progress bar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_biostate_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@color/widget_background">

    <!-- Label text -->
    <TextView
        android:id="@+id/biostate_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recovery"
        android:textColor="@color/widget_text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

    <!-- Horizontal Progress Bar -->
    <ProgressBar
        android:id="@+id/biostate_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/horizontal_progress" />

    <!-- Percentage text -->
    <TextView
        android:id="@+id/biostate_percentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0%"
        android:textColor="@color/widget_accent"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium" />

</LinearLayout>
